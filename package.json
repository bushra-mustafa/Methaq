{
    "$schema": "https://www.schemastore.org/package.json",
    "private": true,
    "type": "module",
    "scripts": {
        "build": "vite build",
        "dev": "vite",
        "typecheck": "tsc --noEmit",
        "test:prototype": "node --experimental-strip-types --test tests/Frontend/prototype-design.test.ts",
        "test:contracts": "node --experimental-strip-types --test tests/Frontend/design-contract.test.ts",
        "test:editor": "node --experimental-strip-types --test tests/Frontend/editor-document.test.ts",
        "test:proposals": "node --experimental-strip-types --test tests/Frontend/ivory-proposal.test.ts",
        "test:envelope": "node --experimental-strip-types --test tests/Frontend/envelope.test.ts",
        "test:consent": "node --experimental-strip-types --test tests/Frontend/consent.test.ts",
        "test:frontend": "npm run test:prototype && npm run test:contracts && npm run test:editor && npm run test:proposals && npm run test:envelope && npm run test:consent"
    },
    "devDependencies": {
        "@tailwindcss/vite": "^4.0.0",
        "@types/node": "^22.0.0",
        "@types/react": "^19.0.0",
        "@types/react-dom": "^19.0.0",
        "@vitejs/plugin-react": "^5.0.0",
        "axios": "^1.11.0",
        "concurrently": "^9.0.1",
        "laravel-vite-plugin": "^2.0.0",
        "tailwindcss": "^4.0.0",
        "typescript": "~5.9.0",
        "vite": "^7.0.7"
    },
    "dependencies": {
        "@inertiajs/react": "^2.0.0",
        "fabric": "^6.0.0",
        "lucide-react": "^1.72.0",
        "react": "^19.0.0",
        "react-dom": "^19.0.0"
    }
}
